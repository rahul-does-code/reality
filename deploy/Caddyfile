# Replace your-domain.example with your domain (its DNS A record must point at this server).
# Caddy gets and renews the Let's Encrypt certificate itself; camera and microphone need HTTPS.
your-domain.example {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(self)"
		-Server
	}

	# Image edits post a frame plus a highlight (base64 JSON); the app caps bodies at 8 MB.
	request_body {
		max_size 10MB
	}

	reverse_proxy 127.0.0.1:3000
}

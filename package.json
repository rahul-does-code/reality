{
  "name": "reality-is-yours",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "server": "tsx watch server/proxy.ts",
    "dev:all": "concurrently -k -n web,api -c magenta,cyan \"npm:dev\" \"npm:server\"",
    "test:commands": "node scripts/test-commands.mjs",
    "test:edit": "node scripts/test-edit.mjs",
    "test:select": "tsx scripts/test-select.mts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
